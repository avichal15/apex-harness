# ==============================================================================
# Apex Harness Configuration Example
# Copy this file to `.env` and fill in ONLY the keys/gateways you want to use.
# NEVER commit `.env` or any file containing real API keys or OAuth tokens.
# ==============================================================================

# Studio Server & Workspace Discovery
APEX_APP_PORT=5199
# Optional comma-separated parent folders containing local project repositories
APEX_EXTRA_WORKSPACE_ROOTS=

# Unified OpenAI-Compatible Gateway (OmniRoute / LiteLLM / OpenRouter / vLLM)
APEX_GATEWAY_URL=
APEX_GATEWAY_API_KEY=
APEX_GATEWAY_MODEL=

# Direct Provider Keys (Optional - leave empty if using CLI drivers / ACP)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
NVIDIA_NIM_API_KEY=

# Optional Docker / Compose Base Runtime Settings
COMPOSE_PROJECT_NAME=apex-harness
OMB_BIND_ADDRESS=127.0.0.1
OMB_HTTP_PORT=8080
OMB_PUBLIC_URL=
OMB_WEBHOOK_PUBLIC_URL=
OMB_HTTPS_HOST=
ENGINES="@anthropic-ai/claude-code @openai/codex"
OMB_DATA_VOLUME=
OMB_DATA_EXTERNAL=false
